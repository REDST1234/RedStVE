# Local Development Environment Variables
# Copy this file to .env and fill in your local values.
# cp .env.template .env

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_video
DB_USERNAME=root
DB_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD_PASSWORD=root

# Vector / Chroma
CHROMA_HOST=http://localhost
CHROMA_PORT=8000
CHROMA_KEY_TOKEN=
CHROMA_USERNAME=
CHROMA_PASSWORD=
CHROMA_TENANT_NAME=default_tenant
CHROMA_DATABASE_NAME=default_database
CHROMA_COLLECTION_NAME=ai_video
CHROMA_INITIALIZE_SCHEMA=true

# Vector / Ollama Embedding
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
SPRING_AI_MODEL_EMBEDDING=ollama

# Ark / Doubao ASR
ARK_BASE_URL=https://ark.cn-beijing.volces.com
ARK_API_KEY=your-ark-api-key
ARK_CHAT_COMPLETIONS_PATH=/api/v3/chat/completions
ARK_TIMEOUT_SECONDS=200
ARK_MAX_RETRIES=1
ASR_DOUBAO_MODEL=doubao-seed-2-0-lite-260428
ASR_MAX_AUDIO_BYTES=20971520
ASR_AUDIO_OUTPUT_DIR=storage/analysis-audio
