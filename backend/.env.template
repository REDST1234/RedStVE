# Local Development Environment Variables
# Copy this file to .env and fill in your local values.
# cp .env.template .env

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_video
DB_USERNAME=root
DB_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
